# UNA TANTUM VOCE — Backend Environment Variables
# Copy this file to .env and fill in your values
# Never commit .env to git

# ─── App ─────────────────────────────────────────────────────────────────────
APP_NAME=UNA TANTUM VOCE
APP_ENV=development
DEBUG=True

# ─── Database ────────────────────────────────────────────────────────────────
# Local SQLite database (runs instantly without PostgreSQL or Docker):
DATABASE_URL=sqlite:///./sql_app.db
# Production (Render will inject this automatically via render.yaml)
# DATABASE_URL=postgresql://...

# ─── Security ────────────────────────────────────────────────────────────────
SECRET_KEY=una-tantum-voce-dev-secret-CHANGE-IN-PRODUCTION-2024
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Admin setup protection — required header to call POST /api/auth/admin-setup
ADMIN_SETUP_SECRET=change-me-to-something-secret-2024

# ─── Admin Account ────────────────────────────────────────────────────────────
ADMIN_EMAIL=unatantumvoceofficial@gmail.com
ADMIN_PASSWORD=utv2025

# ─── Frontend ────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── AWS S3 / Cloudflare R2 (optional — local disk fallback if not set) ──────
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=utv-platform-assets
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# S3_CUSTOM_DOMAIN=https://pub-yourdomain.r2.dev

# ─── Stripe Payments ─────────────────────────────────────────────────────────
# Get keys at https://dashboard.stripe.com/apikeys
# Use sk_test_... / pk_test_... for testing
# STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ─── Email (Gmail SMTP) ───────────────────────────────────────────────────────
# 1. Enable 2FA on Gmail
# 2. Create App Password at https://myaccount.google.com/apppasswords
# 3. Set EMAIL_ENABLED=True once configured
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_ENABLED=False
# EMAIL_USER=your-gmail@gmail.com
# EMAIL_PASS=your-16-char-app-password
# EMAIL_FROM=UNA TANTUM VOCE <your-gmail@gmail.com>

# ─── OpenAI (AI Assistant — optional) ────────────────────────────────────────
# OPENAI_API_KEY=sk-your-openai-api-key
